# Juriscorp S.C. — Plantilla de variables de entorno
#
# PLANTILLA. Solo placeholders — nunca valores reales.
# Copiar a .env.production (ignorado por git) y rellenar allí.

# ==========================================
# Frontend Configuration (Safe to expose)
# ==========================================
# Estos valores viajan al navegador y son públicos por diseño.
# Se escriben directamente en index.html / admin/*.html, no se leen de aquí.

# URL de tu sitio en producción
SITE_URL=https://tu-dominio.com

# Site Key de Cloudflare Turnstile (Anti-spam widget)
CLOUDFLARE_TURNSTILE_SITE_KEY=0xTU_SITE_KEY_AQUI

# Número de WhatsApp asociado al click-to-chat.
# Formato E.164 sin '+': código de país + número completo.
# Panamá: 507 + 8 dígitos (móviles empiezan por 6) = 11 dígitos en total.
WHATSAPP_NUMBER=507XXXXXXXX

# ==========================================
# Backend Configuration (Supabase Edge Function)
# ESTOS SON SECRETOS - NO DEBEN IR EN EL FRONTEND
# ==========================================
# Se configuran con:  supabase secrets set NOMBRE=valor
# La Edge Function los lee con Deno.env.get(). Este archivo NO se lee
# en tiempo de ejecución: es solo referencia.

# URL del proyecto de Supabase (Settings -> API).
# La plataforma la inyecta automáticamente en las Edge Functions.
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publicable / anon (Settings -> API). Pública por diseño:
# va embebida en admin/index.html. Su seguridad depende de RLS.
SUPABASE_ANON_KEY=sb_publishable_TU_CLAVE_AQUI

# Clave service_role. IGNORA RLS POR COMPLETO — trátala como una
# contraseña de administrador de la base de datos.
#
# OJO CON EL NOMBRE: sin el prefijo SUPABASE_. La plataforma reserva ese
# prefijo y rechaza `supabase secrets set SUPABASE_*`, así que la función
# la lee como SERVICE_ROLE_KEY (ver submit-lead/index.ts:302).
# Si este secreto no está configurado, la función devuelve 500 y NINGÚN
# lead se guarda.
SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI

# Secret Key de Cloudflare Turnstile (Para validación server-side)
CLOUDFLARE_TURNSTILE_SECRET=0xTU_SECRET_KEY_AQUI

# Credenciales de Resend API (Para el envío de correos)
RESEND_API_KEY=re_TU_API_KEY_AQUI

# Buzón que recibe la notificación de cada lead nuevo.
NOTIFICATION_EMAIL=destinatario@tu-dominio.com

# Remitente de las notificaciones. OPCIONAL: si no se define, la función
# usa el fallback de submit-lead/index.ts.
# El dominio debe estar VERIFICADO en Resend (SPF + DKIM). Un subdominio
# verificado NO cubre el dominio apex: send.ejemplo.com y ejemplo.com son
# dominios distintos para Resend, y usar el equivocado devuelve 403.
RESEND_FROM=Juriscorp S.C. <notificaciones@send.tu-dominio.com>
